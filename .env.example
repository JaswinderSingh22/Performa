# Supabase — public (browser + server SSR)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: production OAuth redirects (fallback is request origin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enable Google OAuth: Supabase Dashboard → Authentication → Providers → Google,
# plus add redirect URL: http://localhost:3000/auth/callback (and prod URL).

# Razorpay (subscriptions billed in ₹ INR — use test keys in development)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret from Razorpay Dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=
# Create matching subscription plans (INR recurring) and paste IDs:
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_YEARLY=
RAZORPAY_PLAN_PRO_PLUS_MONTHLY=
RAZORPAY_PLAN_PRO_PLUS_YEARLY=

# Never expose publicly; server-side OpenAI integration (reviews assistant)
OPENAI_API_KEY=
# Optional override (default gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini


# ── Resend (transactional email — review form links) ───────────────────────
# 1. Create a free account at resend.com
# 2. Copy your API key from resend.com/api-keys
# 3. Verify a sending domain at resend.com/domains  (e.g. mail.yourdomain.com)
#    → Without a verified domain, Resend sandbox mode only delivers to your
#      own registered email and will reject sends to employee addresses.
# 4. Set RESEND_FROM_EMAIL to any address on that verified domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Optional — sender display name shown in email clients (default: PerformaAI)
RESEND_FROM_NAME=PerformaAI
# Optional — workspace invites: Send Resend magic link even when Supabase already
# sent its invite email (doubles inbox; useful for debugging). Default: omit.
# WORKSPACE_INVITE_ALWAYS_RESEND=1

# Support / contact links shown in the UI
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_LINKEDIN_URL=

# Local development only — until Auth is wired, use together with SERVICE_ROLE_KEY
# to emulate a tenant. Paste the UUID returned from `organizations.id` seed SQL.
# Remove this path before shipping production.
DEV_ORG_ID=
 