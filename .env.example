# Supabase — public (browser + server SSR)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: production OAuth redirects (fallback is request origin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enable Google OAuth: Supabase Dashboard → Authentication → Providers → Google,
# plus add redirect URL: http://localhost:3000/auth/callback (and prod URL).

# Never expose publicly; server-side OpenAI integration (reviews assistant)
OPENAI_API_KEY=
# Optional override (default gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini


# Local development only — until Auth is wired, use together with SERVICE_ROLE_KEY
# to emulate a tenant. Paste the UUID returned from `organizations.id` seed SQL.
# Remove this path before shipping production.
DEV_ORG_ID=
